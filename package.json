{
  "name": "amalyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Warcraft Logs window damage analyzer (Amalyzer)",
  "scripts": {
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "build": "npm run typecheck",
    "dev": "netlify dev"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
